{
  "manifest_version": 2,
  "name": "CustomSheet",
  "version": "1.0",
  "description": "Toggle custom CSS stylesheets for specific sites.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Toggle custom stylesheet"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "<all_urls>"
  ],
  "commands": {
    "toggle-stylesheet": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      },
      "description": "Toggle custom CSS for current tab"
    }
  }
}
